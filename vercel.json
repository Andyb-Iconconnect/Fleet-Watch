{
  "version": 2,
  "builds": [
    {
      "src": "server/vercel.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "console.html",
          "fleet.js",
          "config.js",
          "fleet-template.csv",
          "js/**",
          "css/**",
          "data/**",
          "assets/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server/vercel.js"
    }
  ],
  "env": {
    "FEED_PROVIDER": "myshiptracking",
    "FEED_KEY": "@myshiptracking_key",
    "FEED_SECRET": "@myshiptracking_secret",
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_KEY": "@supabase_key"
  }
}
